  "license": "ISC",
  "dependencies": {
    "aws-amplify": "^6.14.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.15.0",
    "@aws-amplify/backend-cli": "^1.5.0",
    "@types/node": "^22.14.1",
    "@types/pg": "^8.23.1",
    "aws-cdk": "^2.1010.0",
    "aws-cdk-lib": "^2.190.0",
    "constructs": "^10.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vite-plugin-dts": "^4.5.3",
