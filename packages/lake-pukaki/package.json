  "description": "AWS Amplify Gen 2 based backend app",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "start:aws-amplify-sandbox": "ampx sandbox --profile $AWS_PROFILE",
    "stop:aws-amplify-sandbox": "ampx sandbox delete --profile $AWS_PROFILE",
    "test:schema": "tsx --tsconfig tsconfig.json tests/schema-integrity.ts"
  },
